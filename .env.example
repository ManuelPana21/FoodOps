# ==============================================================================
# FoodOps - Environment Variables Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PORT=4000

# Frontend Configuration (Vite)
VITE_APP_NAME="FoodOps"
VITE_API_BASE_URL="http://localhost:4000/api"
VITE_ENABLE_MOCK_DATA=true

# Database Configuration (SQLite)
DB_DIALECT=sqlite3
DB_STORAGE=./database/foodops.db

# Seguridad y Autenticación JWT (Backend FastAPI)
JWT_SECRET_KEY=cambia-esta-clave-secreta-en-produccion-foodops-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Credenciales Iniciales para Semillas (init_db.py)
SEED_WAITER_USERNAME=mesero
SEED_WAITER_PASSWORD=mesero123
SEED_KITCHEN_USERNAME=cocinero
SEED_KITCHEN_PASSWORD=cocina123
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# Kitchen Display System (KDS) & Real-time Settings
KDS_REFRESH_INTERVAL_MS=5000
VITE_KDS_AUTO_REFRESH=true
