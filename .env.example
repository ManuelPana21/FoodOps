# ==============================================================================
# FoodOps - Environment Variables Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000

# Frontend Configuration (Vite)
VITE_APP_NAME="FoodOps"
VITE_API_BASE_URL="http://localhost:4000/api"
VITE_ENABLE_MOCK_DATA=true

# Database Configuration (SQLite)
# Adaptado de MySQL a SQLite para simplificar despliegue local y desarrollo ligero
DB_DIALECT=sqlite3
DB_STORAGE=./database/foodops.db

# Configuración Legacy de MySQL (Referencia histórica)
# DB_DIALECT=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=foodops_db
# DB_USER=root
# DB_PASSWORD=secret

# Kitchen Display System (KDS) & Real-time Settings
KDS_REFRESH_INTERVAL_MS=5000
VITE_KDS_AUTO_REFRESH=true
