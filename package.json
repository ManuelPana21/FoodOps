{
  "name": "foodops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "FoodOps - Sistema ligero de toma de pedidos y cola de preparación de cocina (KDS)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:init": "python database/init_db.py",
    "db:seed": "python database/init_db.py",
    "api:dev": "uvicorn backend.main:app --host 0.0.0.0 --port 4000 --reload",
    "api:test": "pytest backend/tests -v"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.6.3",
    "vite": "^6.2.0",
    "vitest": "^5.1.1"
  }
}
